# Cổng & địa chỉ bind cho production server (npm run start / node dist-server/prod.mjs)
PORT=3000
HOST=0.0.0.0

# Đặt TRUST_PROXY=1 khi chạy sau Reverse Proxy (Vercel, Railway, Caddy, Nginx)
TRUST_PROXY=1

# Kết nối PostgreSQL / Supabase Transaction Pooler cho Vercel/Cloud (bỏ trống nếu dùng SQLite cục bộ)
# POSTGRES_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_URL=
KAIWATUBE_DB_SCHEMA=kaiwatube

# Đường dẫn file SQLite khi chạy local/VPS Volume (bỏ qua nếu đã cấu hình POSTGRES_URL/DATABASE_URL)
NIHONGO_DB_PATH=./nihongo.db

# Bí mật dùng để kích hoạt quyền Admin khi đăng ký hoặc nâng cấp tài khoản (>= 32 ký tự ngẫu nhiên)
ADMIN_SECRET=change-this-to-your-own-admin-secret-key

# Secret ký JWT phiên đăng nhập (>= 32 ký tự ngẫu nhiên; tự sinh nếu để trống)
JWT_SECRET=change-this-to-a-long-random-secret
