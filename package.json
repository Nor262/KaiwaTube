{
  "name": "kaiwatube",
  "description": "KaiwaTube – Học tiếng Nhật qua video YouTube & Anime với phụ đề song ngữ, phân tích Kanji/bộ thủ và AI Gemini",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build:client": "tsc && vite build",
    "build:server": "esbuild server/prod.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/prod.mjs",
    "build": "tsc && vite build && esbuild server/prod.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/prod.mjs",
    "start": "node dist-server/prod.mjs",
    "preview": "vite preview",
    "test": "bun test"
  },
  "dependencies": {
    "@vercel/functions": "^3.11.3",
    "lucide-react": "^1.16.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tiny-segmenter": "^0.2.0",
    "youtube-transcript": "^1.3.1",
    "yt-search": "^2.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
